# cd_core_target(<name>): apply project warnings and optional sanitizers to a core library.
function(cd_core_target name)
  if(MSVC)
    target_compile_options(${name} PRIVATE /W4 /permissive- /utf-8)
    target_compile_definitions(${name} PUBLIC _USE_MATH_DEFINES NOMINMAX)
  else()
    target_compile_options(${name} PRIVATE -Wall -Wextra -Wpedantic)
    if(CD_SANITIZE)
      target_compile_options(${name} PUBLIC -fsanitize=address,undefined,float-cast-overflow -fno-omit-frame-pointer)
      target_link_options(${name} PUBLIC -fsanitize=address,undefined,float-cast-overflow)
    endif()
  endif()
  if(CD_BUILD_PLUGIN)
    set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
  endif()
endfunction()

# cd_add_test(<name> [TEST_NAME <ctest name>] SOURCES ... LIBS ...): executable registered with CTest.
function(cd_add_test name)
  cmake_parse_arguments(T "" "TEST_NAME" "SOURCES;LIBS" ${ARGN})
  if(NOT T_TEST_NAME)
    set(T_TEST_NAME ${name})
  endif()
  add_executable(${name} ${T_SOURCES})
  target_link_libraries(${name} PRIVATE ${T_LIBS})
  if(MSVC)
    target_compile_options(${name} PRIVATE /utf-8)
    target_compile_definitions(${name} PRIVATE _USE_MATH_DEFINES NOMINMAX _CRT_SECURE_NO_WARNINGS)
  endif()
  add_test(NAME ${T_TEST_NAME} COMMAND ${name})
endfunction()
